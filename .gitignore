
```gitignore
# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables
.env
.env.local
.env.production

# Build outputs
dist/
build/
.DS_Store

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
logs/
*.log

# OS files
Thumbs.db
.DS_Store

# MongoDB
dump/

# Vite
.vite/

# Temp files
*.tmp
*.temp

# Create/update .gitignore
echo "node_modules/" >> .gitignore
echo "package-lock.json" >> .gitignore
echo "client/node_modules" >> .gitignore
echo "server/node_modules" >> .gitignore
echo "client/package-lock.json" >> .gitignore
echo "server/package-lock.json" >> .gitignore
echo ".env" >> .gitignore
echo ".vite/" >> .gitignore
echo "dist/" >> .gitignore